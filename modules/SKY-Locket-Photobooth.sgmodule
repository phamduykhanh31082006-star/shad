#!name=SKY Locket Photobooth Filter - Compatibility Check
#!desc=Photobooth filter compatibility diagnostics for Locket native camera. Read-only; does not add native filters.
#!author=SKY
#!homepage=https://github.com/phamduykhanh31082006-star/shad/tree/main/photobooth
#!url=https://raw.githubusercontent.com/phamduykhanh31082006-star/shad/main/modules/SKY-Locket-Photobooth.sgmodule

# This module is an integration diagnostic, not a native Photobooth filter.
# Shadowrocket script runtime cannot access Locket's camera frames or native UI.
# Do not combine with unrelated subscription/entitlement scripts.
[Script]
sky_photobooth_compatibility = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/, script-path=https://raw.githubusercontent.com/phamduykhanh31082006-star/shad/main/js/Locket_Filter_Probe.js, requires-body=false, timeout=10

[MITM]
hostname = %APPEND% api.locketcamera.com
